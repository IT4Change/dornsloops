{
  "name": "dornsloops",
  "version": "1.0.0",
  "description": "A wall of short video loops, self-hosted with a credit to every source.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "add": "node scripts/ingest.mjs",
    "test:lint": "npm run test:lint:eslint && npm run test:lint:typecheck",
    "test:lint:eslint": "eslint --max-warnings 0 .",
    "test:lint:typecheck": "nuxt typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT4Change/dornsloops.git"
  },
  "keywords": [
    "loops",
    "pr0gramm",
    "nuxt"
  ],
  "bugs": {
    "url": "https://github.com/IT4Change/dornsloops/issues"
  },
  "homepage": "https://github.com/IT4Change/dornsloops#readme",
  "dependencies": {
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-it4c": "^0.13.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
