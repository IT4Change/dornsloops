{
  "name": "dornsloops",
  "version": "1.0.1",
  "description": "A wall of short video loops, self-hosted with a credit to every source.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env TZ=UTC nuxt dev",
    "build": "cross-env TZ=UTC nuxt build",
    "generate": "cross-env TZ=UTC nuxt generate",
    "preview": "cross-env TZ=UTC nuxt preview",
    "postinstall": "nuxt prepare",
    "add": "node scripts/ingest.mjs",
    "test:lint": "npm run test:lint:eslint && npm run test:lint:typecheck",
    "test:lint:eslint": "eslint --max-warnings 0 .",
    "test:lint:typecheck": "nuxt typecheck",
    "test:unit": "vitest run --coverage",
    "test:unit:dev": "vitest",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT4Change/dornsloops.git"
  },
  "keywords": [
    "loops",
    "pr0gramm",
    "nuxt"
  ],
  "bugs": {
    "url": "https://github.com/IT4Change/dornsloops/issues"
  },
  "homepage": "https://github.com/IT4Change/dornsloops#readme",
  "dependencies": {
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-it4c": "^0.13.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
